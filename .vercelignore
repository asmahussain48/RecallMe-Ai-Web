# Vercel only hosts the static web page (RecallMe_v2.html + script.js + tailwind.css).
# vercel.json does the real work: it forces the "Other" (static) preset — otherwise Vercel
# sees server.py's Flask app and tries to bundle Whisper + PyTorch (~5.5 GB) into a
# serverless function — and publishes only those three files from dist/.
# This list just keeps the backend out of CLI uploads too.
server.py
requirements.txt
recallme_env/
node_modules/
__pycache__/
.env
.env.*
